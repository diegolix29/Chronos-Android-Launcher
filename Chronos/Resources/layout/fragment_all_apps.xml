<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#11000000"
    android:padding="0dp">

	<TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Application Library"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:textColor="#FFFFFF"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:paddingStart="20dp" />

	<ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

	<ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">

				<TextView
                    android:id="@+id/txtGamesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Games &amp; Emulators"
                    android:textColor="#AAFFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

				<TextView
                    android:id="@+id/txtGamesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0)"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

			</LinearLayout>

			<androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:clickable="true"
                android:focusable="true"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:overScrollMode="never" />

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp">

				<TextView
                    android:id="@+id/txtSystemLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Apps"
                    android:textColor="#AAFFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

				<TextView
                    android:id="@+id/txtSystemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0)"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

			</LinearLayout>

			<androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:clickable="true"
                android:focusable="true"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:overScrollMode="never" />

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp">

				<TextView
                    android:id="@+id/txtOtherLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other Applications"
                    android:textColor="#AAFFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

				<TextView
                    android:id="@+id/txtOtherCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0)"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

			</LinearLayout>

			<androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:clickable="true"
                android:focusable="true"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:overScrollMode="never" />

		</LinearLayout>
	</ScrollView>
</LinearLayout>