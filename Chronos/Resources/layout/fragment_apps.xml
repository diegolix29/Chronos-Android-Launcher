<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#11000000">
	<!-- Selection Bar -->
	<LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF2A2A2A"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_marginBottom="10dp"
        android:elevation="6dp">

		<Button
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Select All"
            android:textSize="13sp" />

		<Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:textSize="13sp"
            android:layout_marginHorizontal="8dp" />

		<Button
            android:id="@+id/btnCancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Cancel"
            android:textSize="13sp" />
	</LinearLayout>

	<!-- Header -->
	<LinearLayout
        android:id="@+id/headerToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_list_item_focus"
        android:clickable="true"
        android:focusable="true">

		<TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Controls"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

		<ImageButton
            android:id="@+id/btnToggleCollapse"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_navigation_button_focus"
            android:src="@android:drawable/arrow_down_float"
            android:contentDescription="Toggle Controls" />
	</LinearLayout>

	<!-- Control Buttons -->
	<LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

		<Button
            android:id="@+id/btnAddApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Add Android App" />

		<Button
            android:id="@+id/btnAddGame"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Add Game File"
            android:layout_marginTop="8dp" />

		<Button
            android:id="@+id/btnFetchAllCovers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fetch Game Covers"
            android:layout_marginTop="8dp" />

		<Button
			android:id="@+id/btnAddConsoleFolder"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="+ Add Console Folder"
			android:backgroundTint="#444"
			android:textColor="#FFF"
			android:layout_marginTop="20dp" />
	</LinearLayout>

	<!-- Content -->
	<ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apps"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="8dp" />

			<GridLayout
                android:id="@+id/appGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8"
                android:alignmentMode="alignMargins" />

			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Games"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="8dp"
                android:layout_marginTop="16dp" />

			<GridLayout
                android:id="@+id/gameGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:alignmentMode="alignMargins" />

			<LinearLayout
				android:id="@+id/dynamicConsoleContainer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="10dp" />

		</LinearLayout>
	</ScrollView>

</LinearLayout>
