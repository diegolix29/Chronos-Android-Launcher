<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#2B2B2B">

	<TextView
        android:id="@+id/txtEmuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emulator Required"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

	<TextView
        android:id="@+id/txtEmuMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To play this game, you need to install the corresponding emulator."
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp" />

	<TextView
        android:id="@+id/txtRetroArchNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#3D3D3D"
        android:padding="10dp"
        android:text="Note: This system uses RetroArch. Please open RetroArch and download the required core via the Online Updater."
        android:textColor="#FFCC00"
        android:textSize="13sp"
        android:visibility="gone" />

	<Button
        android:id="@+id/btnDownloadEmu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Download Emulator"
        android:backgroundTint="#0078D7"
        android:textColor="#FFFFFF" />

	<CheckBox
        android:id="@+id/chkSkipPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Don't show this reminder again"
        android:textColor="#999999"
        android:textSize="12sp"
        android:buttonTint="#999999" />

</LinearLayout>