/* ==================== Neon Dreams Theme ==================== */

/* --- GLOBAL WINDOW & CONTAINERS --- */
QMainWindow, QDialog, QStackedWidget, QScrollArea, QFrame {
    background-color: #0a0014;
    color: #00ffff;
    border: none;
}

QWidget { 
    color: #00ffff; 
    background-color: transparent;
}

/* --- GROUP BOXES & PANELS --- */
QGroupBox {
    border: 1px solid #ff00ff;
    border-left: 3px solid #00ff00;
    border-radius: 12px;
    margin-top: 22px;
    padding-top: 12px;
    background-color: rgba(10, 0, 20, 180);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 6px;
    color: #ff00ff;
    font-weight: bold;
    font-size: 12pt;
    text-transform: uppercase;
}

/* --- LISTS & TABLES --- */
QListView, QTableView, QListWidget, QHeaderView, QHeaderView::section {
    background-color: transparent;
    border: none;
    color: #00ffff;
    selection-background-color: rgba(255, 0, 255, 0.3);
}

QListView::item, QTableView::item, QListWidget::item {
    background-color: transparent;
    border: none;
    padding: 12px;
    color: #00ffff;
    border-radius: 6px;
}

QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: rgba(255, 0, 255, 0.4);
    color: #ffffff;
    border-left: 3px solid #00ff00;
}

QListView::item:hover, QTableView::item:hover, QListWidget::item:hover {
    background-color: rgba(0, 255, 255, 0.2);
}

/* --- TOOLBAR --- */
QToolBar {
    background-color: rgba(10, 0, 20, 200);
    border-bottom: 2px solid #ff00ff;
    padding: 8px;
    spacing: 12px;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: rgba(255, 0, 255, 0.1);
    color: #00ffff;
    border: 1px solid #ff00ff;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: rgba(0, 255, 255, 0.2);
    border: 1px solid #00ffff;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #ff00ff;
    color: #000000;
}

/* --- INPUTS --- */
QLineEdit, QComboBox {
    background-color: rgba(255, 0, 255, 0.1);
    color: #00ffff;
    border: 1px solid #00ffff;
    border-radius: 8px;
    padding: 10px 14px;
    selection-background-color: rgba(0, 255, 255, 0.5);
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #00ff00;
    background-color: rgba(0, 255, 0, 0.1);
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: rgba(10, 0, 20, 150);
    width: 14px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background: linear-gradient(to bottom, #ff00ff, #00ffff);
    border-radius: 7px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* --- CHECKBOXES --- */
QCheckBox {
    color: #00ffff;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    background-color: rgba(255, 0, 255, 0.1);
    border: 2px solid #ff00ff;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #00ff00;
    border: 2px solid #00ff00;
}

/* --- LABELS --- */
QLabel {
    background: transparent;
    color: #00ffff;
}

/* --- TABS --- */
QTabWidget::pane {
    border: 1px solid #ff00ff;
    background-color: rgba(10, 0, 20, 200);
}

QTabBar::tab {
    background-color: rgba(255, 0, 255, 0.1);
    color: #00ffff;
    border: 1px solid #ff00ff;
    padding: 10px 18px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #00ff00;
    color: #000000;
}

QTabBar::tab:hover {
    background-color: rgba(0, 255, 255, 0.2);
}

/* --- PROGRESS BARS --- */
QProgressBar {
    border: 1px solid #ff00ff;
    border-radius: 8px;
    text-align: center;
    background-color: rgba(10, 0, 20, 150);
}

QProgressBar::chunk {
    background: linear-gradient(to right, #ff00ff, #00ffff);
    border-radius: 7px;
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    border: 1px solid #ff00ff;
    height: 10px;
    background-color: rgba(10, 0, 20, 150);
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background: radial-gradient(circle, #00ff00, #ff00ff);
    border: 2px solid #00ffff;
    width: 22px;
    margin: -6px 0;
    border-radius: 11px;
}

QSlider::handle:horizontal:hover {
    background: radial-gradient(circle, #00ffff, #ff00ff);
}

/* --- MENU --- */
QMenu {
    background-color: rgba(10, 0, 20, 200);
    border: 1px solid #ff00ff;
    padding: 6px;
}

QMenu::item {
    padding: 10px 18px;
    color: #00ffff;
}

QMenu::item:selected {
    background-color: rgba(255, 0, 255, 0.3);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #ff00ff;
    margin: 6px 10px;
}
