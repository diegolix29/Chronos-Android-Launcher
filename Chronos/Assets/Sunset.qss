/* ==================== Sunset Paradise Theme ==================== */

/* --- GLOBAL WINDOW & CONTAINERS --- */
QMainWindow, QDialog, QStackedWidget, QScrollArea, QFrame {
    background-color: #1a0f1f;
    color: #ffd4a3;
    border: none;
}

QWidget { 
    color: #ffd4a3; 
    background-color: transparent;
}

/* --- GROUP BOXES & PANELS --- */
QGroupBox {
    border: 1px solid #ff6b35;
    border-left: 3px solid #f7931e;
    border-radius: 10px;
    margin-top: 22px;
    padding-top: 12px;
    background-color: rgba(26, 15, 31, 180);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 6px;
    color: #ff6b35;
    font-weight: bold;
    font-size: 12pt;
}

/* --- LISTS & TABLES --- */
QListView, QTableView, QListWidget, QHeaderView, QHeaderView::section {
    background-color: transparent;
    border: none;
    color: #ffd4a3;
    selection-background-color: rgba(255, 107, 53, 0.3);
}

QListView::item, QTableView::item, QListWidget::item {
    background-color: transparent;
    border: none;
    padding: 12px;
    color: #ffd4a3;
    border-radius: 6px;
}

QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: rgba(247, 147, 30, 0.4);
    color: #1a0f1f;
    border-left: 3px solid #ff6b35;
}

QListView::item:hover, QTableView::item:hover, QListWidget::item:hover {
    background-color: rgba(255, 107, 53, 0.2);
}

/* --- TOOLBAR --- */
QToolBar {
    background-color: rgba(26, 15, 31, 200);
    border-bottom: 2px solid #ff6b35;
    padding: 8px;
    spacing: 12px;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: rgba(247, 147, 30, 0.2);
    color: #ffd4a3;
    border: 1px solid #ff6b35;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(255, 107, 53, 0.3);
    border: 1px solid #f7931e;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #ff6b35;
    color: #1a0f1f;
}

/* --- INPUTS --- */
QLineEdit, QComboBox {
    background-color: rgba(247, 147, 30, 0.1);
    color: #ffd4a3;
    border: 1px solid #f7931e;
    border-radius: 8px;
    padding: 10px 14px;
    selection-background-color: rgba(255, 107, 53, 0.5);
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #ff6b35;
    background-color: rgba(255, 107, 53, 0.1);
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: rgba(26, 15, 31, 150);
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: linear-gradient(to bottom, #ff6b35, #f7931e);
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* --- CHECKBOXES --- */
QCheckBox {
    color: #ffd4a3;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: rgba(247, 147, 30, 0.1);
    border: 2px solid #f7931e;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #ff6b35;
    border: 2px solid #ff6b35;
}

/* --- LABELS --- */
QLabel {
    background: transparent;
    color: #ffd4a3;
}

/* --- TABS --- */
QTabWidget::pane {
    border: 1px solid #ff6b35;
    background-color: rgba(26, 15, 31, 200);
}

QTabBar::tab {
    background-color: rgba(247, 147, 30, 0.1);
    color: #ffd4a3;
    border: 1px solid #f7931e;
    padding: 10px 18px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #ff6b35;
    color: #1a0f1f;
}

QTabBar::tab:hover {
    background-color: rgba(255, 107, 53, 0.2);
}

/* --- PROGRESS BARS --- */
QProgressBar {
    border: 1px solid #ff6b35;
    border-radius: 8px;
    text-align: center;
    background-color: rgba(26, 15, 31, 150);
}

QProgressBar::chunk {
    background: linear-gradient(to right, #ff6b35, #f7931e);
    border-radius: 7px;
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    border: 1px solid #f7931e;
    height: 8px;
    background-color: rgba(26, 15, 31, 150);
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #ff6b35;
    border: 2px solid #f7931e;
    width: 20px;
    margin: -6px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background-color: #f7931e;
}

/* --- MENU --- */
QMenu {
    background-color: rgba(26, 15, 31, 200);
    border: 1px solid #ff6b35;
    padding: 6px;
}

QMenu::item {
    padding: 10px 18px;
    color: #ffd4a3;
}

QMenu::item:selected {
    background-color: rgba(255, 107, 53, 0.3);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #ff6b35;
    margin: 6px 10px;
}
