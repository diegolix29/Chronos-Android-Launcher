/* ==================== Forest Mystique Theme ==================== */

/* --- GLOBAL WINDOW & CONTAINERS --- */
QMainWindow, QDialog, QStackedWidget, QScrollArea, QFrame {
    background-color: #0d1f0d;
    color: #a8d5a8;
    border: none;
}

QWidget { 
    color: #a8d5a8; 
    background-color: transparent;
}

/* --- GROUP BOXES & PANELS --- */
QGroupBox {
    border: 1px solid #4a7c4a;
    border-left: 3px solid #8fbc8f;
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 12px;
    background-color: rgba(13, 31, 13, 180);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 6px;
    color: #8fbc8f;
    font-weight: bold;
    font-size: 12pt;
}

/* --- LISTS & TABLES --- */
QListView, QTableView, QListWidget, QHeaderView, QHeaderView::section {
    background-color: transparent;
    border: none;
    color: #a8d5a8;
    selection-background-color: rgba(143, 188, 143, 0.3);
}

QListView::item, QTableView::item, QListWidget::item {
    background-color: transparent;
    border: none;
    padding: 12px;
    color: #a8d5a8;
    border-radius: 6px;
}

QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: rgba(74, 124, 74, 0.4);
    color: #ffffff;
    border-left: 3px solid #8fbc8f;
}

QListView::item:hover, QTableView::item:hover, QListWidget::item:hover {
    background-color: rgba(143, 188, 143, 0.2);
}

/* --- TOOLBAR --- */
QToolBar {
    background-color: rgba(13, 31, 13, 200);
    border-bottom: 2px solid #4a7c4a;
    padding: 8px;
    spacing: 12px;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: rgba(74, 124, 74, 0.2);
    color: #a8d5a8;
    border: 1px solid #4a7c4a;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(143, 188, 143, 0.3);
    border: 1px solid #8fbc8f;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #4a7c4a;
    color: #ffffff;
}

/* --- INPUTS --- */
QLineEdit, QComboBox {
    background-color: rgba(74, 124, 74, 0.1);
    color: #a8d5a8;
    border: 1px solid #8fbc8f;
    border-radius: 8px;
    padding: 10px 14px;
    selection-background-color: rgba(143, 188, 143, 0.5);
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #4a7c4a;
    background-color: rgba(74, 124, 74, 0.1);
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    background: rgba(13, 31, 13, 150);
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: linear-gradient(to bottom, #4a7c4a, #8fbc8f);
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* --- CHECKBOXES --- */
QCheckBox {
    color: #a8d5a8;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: rgba(74, 124, 74, 0.1);
    border: 2px solid #8fbc8f;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #4a7c4a;
    border: 2px solid #4a7c4a;
}

/* --- LABELS --- */
QLabel {
    background: transparent;
    color: #a8d5a8;
}

/* --- TABS --- */
QTabWidget::pane {
    border: 1px solid #4a7c4a;
    background-color: rgba(13, 31, 13, 200);
}

QTabBar::tab {
    background-color: rgba(74, 124, 74, 0.1);
    color: #a8d5a8;
    border: 1px solid #8fbc8f;
    padding: 10px 18px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #4a7c4a;
    color: #ffffff;
}

QTabBar::tab:hover {
    background-color: rgba(143, 188, 143, 0.2);
}

/* --- PROGRESS BARS --- */
QProgressBar {
    border: 1px solid #4a7c4a;
    border-radius: 8px;
    text-align: center;
    background-color: rgba(13, 31, 13, 150);
}

QProgressBar::chunk {
    background: linear-gradient(to right, #4a7c4a, #8fbc8f);
    border-radius: 7px;
}

/* --- SLIDERS --- */
QSlider::groove:horizontal {
    border: 1px solid #8fbc8f;
    height: 8px;
    background-color: rgba(13, 31, 13, 150);
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #4a7c4a;
    border: 2px solid #8fbc8f;
    width: 20px;
    margin: -6px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background-color: #8fbc8f;
}

/* --- MENU --- */
QMenu {
    background-color: rgba(13, 31, 13, 200);
    border: 1px solid #4a7c4a;
    padding: 6px;
}

QMenu::item {
    padding: 10px 18px;
    color: #a8d5a8;
}

QMenu::item:selected {
    background-color: rgba(143, 188, 143, 0.3);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #4a7c4a;
    margin: 6px 10px;
}
